            <zone h='10699' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99156' x='422' y='4449' />
            <zone h='84005' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99156' x='422' y='15148'>
              <flipboard active-id='1' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Сборы и динамика' captured-sheet='Фильмы и сборы' id='1'>
                    <capturedDeltas>
                      <worksheet name='Комбинация количества фильмов и сборов по годам'>
                        <style delta-type='added'>
                          <style-rule element='axis'>
                            <format attr='title' class='0' field='[federated.01nu4fd1d8b3021fnzwtr0493md2].[ctd:Film:qk]' scope='rows' value='Кол-во фильмов' />
                            <format attr='title' class='0' field='[federated.01nu4fd1d8b3021fnzwtr0493md2].[sum:Worldwide Gross:qk]' scope='rows' value='Сборы, млн' />
                          </style-rule>
                        </style>
                        <selection-collection>
                          <node-selection select-tuples='false'>
                            <oriented-node-reference orientation='vertical'>
                              <node-reference>
                                <axis>[federated.01nu4fd1d8b3021fnzwtr0493md2].[sum:Worldwide Gross:qk]</axis>
                              </node-reference>
                              <page-reference />
